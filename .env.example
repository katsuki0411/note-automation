# ===== 必須 =====

# Gemini API キー（ネタ収集 / ホットキーワード発掘 / 検索Grounding）
# 取得: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic API キー（Claude Sonnet 4.6 で記事本文生成）
# 取得: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ===== 推奨（無いとフォールバック動作になります） =====

# Google Custom Search の検索エンジンID（cx）
# 主婦悩み相談系プラットフォームを直接検索するために使用
# 取得: https://programmablesearchengine.google.com/
GOOGLE_CSE_ID=

# Google Custom Search の API キー（GEMINI_API_KEY とは別キー推奨）
# 取得: Google Cloud Console → APIs & Services → Credentials
GOOGLE_CSE_API_KEY=

# ===== 任意 =====

# Brave Search API キー（CSE が使えない時のフォールバック検索）
# 取得: https://api.search.brave.com/app/keys
BRAVE_SEARCH_API_KEY=
