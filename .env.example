# ===== 必須 =====

# Gemini API キー（ネタ収集 / ホットキーワード発掘 / 検索Grounding）
# 取得: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic API キー（Claude Sonnet 4.6 で記事本文生成）
# 取得: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ===== 推奨（無いとフォールバック動作になります） =====

# Google Custom Search の検索エンジンID（cx）
# 主婦悩み相談系プラットフォームを直接検索するために使用
# 取得: https://programmablesearchengine.google.com/
GOOGLE_CSE_ID=

# Google Custom Search の API キー（GEMINI_API_KEY とは別キー推奨）
# 取得: Google Cloud Console → APIs & Services → Credentials
GOOGLE_CSE_API_KEY=

# ===== 任意 =====

# Brave Search API キー（CSE が使えない時のフォールバック検索）
# 取得: https://api.search.brave.com/app/keys
BRAVE_SEARCH_API_KEY=

# ===== Supabase（DB / 必須） =====

# Supabase プロジェクトURL（https://xxxxx.supabase.co）
SUPABASE_URL=

# Supabase anon public キー（Auth セッション cookie 同期に使用）
SUPABASE_ANON_KEY=

# Supabase service_role キー（サーバー側からの全権アクセス用・**絶対公開禁止**）
SUPABASE_SERVICE_ROLE_KEY=

# Postgres 接続URL（Transaction pooler 推奨・ポート6543）
# 例: postgresql://postgres.xxxxx:PASSWORD@aws-X-ap-southeast-2.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ===== Vercel Cron 保護（任意・本番のみ推奨） =====

# Vercel Cron から /api/seo/cron を叩く際の Bearer secret
# 設定するとAuthorizationヘッダ Bearer <値> が必須になる
# Vercel側のCron設定でヘッダを付けて呼び出す
CRON_SECRET=
