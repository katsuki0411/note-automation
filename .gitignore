# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
# /.next* で .next / .next.nosync (iCloud除外用 dev distDir) / ".next 2" (iCloud重複) を一括無視
/.next*
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# generated content
/data
/public/generated-images

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# extension zip（社長配布用一時ファイル）
/note-automation-extension*.zip

# playwright screenshots / cache
/mobile-*.png
/.playwright-mcp
